generator client {
  provider = "prisma-client"
  output   = "../lib/shared/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model BaseList {
  id             String             @id @default(uuid()) @db.Uuid
  name           String
  description    String?
  schema         Json
  userId         String             @map("user_id") @db.Uuid
  organizationId String?            @map("organization_id") @db.Uuid
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")
  templates      BaseListTemplate[]
  entities       ListEntity[]
  tables         Table[]

  @@index([userId])
  @@index([organizationId])
  @@map("base_lists")
}

model ListEntity {
  id         String      @id @default(uuid()) @db.Uuid
  baseListId String      @map("base_list_id") @db.Uuid
  values     Json
  createdAt  DateTime    @default(now()) @map("created_at")
  updatedAt  DateTime    @updatedAt @map("updated_at")
  baseList   BaseList    @relation(fields: [baseListId], references: [id], onDelete: Cascade)
  tableCells TableCell[]

  @@index([baseListId])
  @@map("list_entities")
}

model Table {
  id                      String           @id @default(uuid()) @db.Uuid
  name                    String
  description             String?
  baseListId              String?          @map("base_list_id") @db.Uuid
  userId                  String           @map("user_id") @db.Uuid
  organizationId          String?          @map("organization_id") @db.Uuid
  representativeColumnKey String           @map("representative_column_key")
  schema                  Json
  settings                Json             @default("{}")
  createdAt               DateTime         @default(now()) @map("created_at")
  updatedAt               DateTime         @updatedAt @map("updated_at")
  cells                   TableCell[]
  columns                 TableColumn[]
  baseList                BaseList?        @relation(fields: [baseListId], references: [id])
  entityEmbedding         EntityEmbedding?

  @@index([baseListId])
  @@index([userId])
  @@index([organizationId])
  @@map("tables")
}

model TableColumn {
  id         String      @id @default(uuid()) @db.Uuid
  tableId    String      @map("table_id") @db.Uuid
  key        String
  label      String
  type       ColumnType  @default(TEXT)
  order      Int         @default(0)
  validation Json?
  createdAt  DateTime    @default(now()) @map("created_at")
  updatedAt  DateTime    @updatedAt @map("updated_at")
  cells      TableCell[]
  table      Table       @relation(fields: [tableId], references: [id], onDelete: Cascade)

  @@unique([tableId, key])
  @@index([tableId, order])
  @@map("table_columns")
}

model TableCell {
  id            String      @id @default(uuid()) @db.Uuid
  tableId       String      @map("table_id") @db.Uuid
  tableColumnId String      @map("table_column_id") @db.Uuid
  entityId      String?     @map("entity_id") @db.Uuid
  rowKey        String      @map("row_key")
  value         Json
  entrySource   EntrySource @default(MANUAL) @map("entry_source")
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")
  entity        ListEntity? @relation(fields: [entityId], references: [id], onDelete: Cascade)
  tableColumn   TableColumn @relation(fields: [tableColumnId], references: [id], onDelete: Cascade)
  table         Table       @relation(fields: [tableId], references: [id], onDelete: Cascade)

  @@unique([tableId, rowKey, tableColumnId])
  @@index([tableId, rowKey])
  @@index([tableId, tableColumnId])
  @@index([entityId])
  @@map("table_cells")
}

model ColumnTemplate {
  id             String             @id @default(uuid()) @db.Uuid
  userId         String             @map("user_id") @db.Uuid
  organizationId String?            @map("organization_id") @db.Uuid
  name           String
  description    String?
  category       String?
  schema         Json
  isPublic       Boolean            @default(false) @map("is_public")
  usageCount     Int                @default(0) @map("usage_count")
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")
  baseLists      BaseListTemplate[]

  @@index([userId])
  @@index([organizationId])
  @@index([category])
  @@index([isPublic])
  @@map("column_templates")
}

model BaseListTemplate {
  id         String         @id @default(uuid()) @db.Uuid
  baseListId String         @map("base_list_id") @db.Uuid
  templateId String         @map("template_id") @db.Uuid
  autoSync   Boolean        @default(false) @map("auto_sync")
  appliedAt  DateTime       @default(now()) @map("applied_at")
  baseList   BaseList       @relation(fields: [baseListId], references: [id], onDelete: Cascade)
  template   ColumnTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([baseListId, templateId])
  @@index([baseListId])
  @@index([templateId])
  @@map("base_list_templates")
}

model EntityEmbedding {
  tableId    String   @id @map("table_id") @db.Uuid
  model      String
  dim        Int
  labels     String[]
  vectors    Bytes
  labelsHash String   @map("labels_hash")
  updatedAt  DateTime @updatedAt @map("updated_at")
  table      Table    @relation(fields: [tableId], references: [id], onDelete: Cascade)

  @@map("entity_embeddings")
}

model Organization {
  id               String               @id @default(uuid()) @db.Uuid
  name             String
  slug             String               @unique
  ownerId          String               @map("owner_id") @db.Uuid
  settings         Json                 @default("{}")
  subscriptionTier String               @default("free") @map("subscription_tier")
  maxMembers       Int                  @default(5) @map("max_members")
  createdAt        DateTime             @default(now()) @map("created_at")
  updatedAt        DateTime             @updatedAt @map("updated_at")
  members          OrganizationMember[]

  @@index([ownerId])
  @@map("organizations")
}

model OrganizationMember {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  userId         String       @map("user_id") @db.Uuid
  role           OrgRole      @default(VIEWER)
  joinedAt       DateTime     @default(now()) @map("joined_at")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
  @@map("organization_members")
}

enum OrgRole {
  OWNER
  ADMIN
  EDITOR
  VIEWER

  @@map("org_role")
}

enum ColumnType {
  TEXT
  NUMBER
  DATE
  BOOLEAN

  @@map("column_type")
}

enum EntrySource {
  VOICE
  MANUAL
  IMPORT

  @@map("entry_source")
}
